{
  "name": "aurapad",
  "version": "1.19.0",
  "description": "AuraPad — a lightweight code editor built with Electron and React",
  "author": "Roman Struchev",
  "main": "./out/main/index.js",
  "scripts": {
    "format": "prettier --write .",
    "clean": "node -e \"const fs = require('fs'); ['dist', 'out'].forEach(d => fs.rmSync(d, { recursive: true, force: true }))\"",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "electron-updater": "^6.8.9",
    "ignore": "^7.0.5",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@diffusionstudio/piper-wasm": "^1.0.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@huggingface/transformers": "^4.2.0",
    "@mintplex-labs/piper-tts-web": "^1.0.4",
    "@monaco-editor/react": "^4.7.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "autoprefixer": "^10.5.2",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.11",
    "electron": "^43.1.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "lucide-react": "^1.23.0",
    "marked": "^18.0.5",
    "monaco-editor": "^0.55.1",
    "postcss": "^8.5.16",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
